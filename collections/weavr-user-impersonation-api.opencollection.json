{
  "opencollection": "1.0.0",
  "info": {
    "name": "Weavr Multi Product BackOffice Access Token User Impersonation API",
    "version": "v3"
  },
  "items": [
    {
      "info": {
        "name": "User Impersonation",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Impersonate login for an identity",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://sandbox.weavr.io/multi/backoffice/impersonate_identity_login",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get a token representing the given `identity`. This token can then be used to authorise certain secure\noperations on behalf of the identity.\n"
        }
      ]
    }
  ],
  "bundled": true
}