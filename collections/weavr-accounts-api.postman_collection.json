          "name": "Simulate incoming wire transfer using account id",
          "request": {
            "name": "Simulate incoming wire transfer using account id",
            "description": {
              "content": "This tool is a quick and easy way to put funds on a Managed Account (previously called ‘deposit’), that you may need for testing elsewhere. Provide account id and transaction amount and the transaction will be processed through the system. This method skips some of the steps when processing IWTs. To test this fully, please use the accounts_deposit endpoint.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "accounts",
                ":account_id",
                "deposit"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<long>",
                  "key": "account_id",
                  "description": "(Required) "
                }
              ]
            },
            "header": [
              {
                "disabled": false,
                "description": "A call reference generated by the caller and unique to the caller to provide correlation between the caller and system with a maximum length of 255",
                "key": "call-ref",
                "value": "<string>"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "body": {
