              "raw": "{\n  \"depositAmount\": {\n    \"currency\": \"<string>\",\n    \"amount\": \"<long>\"\n  },\n  \"senderName\": \"<string>\",\n  \"reference\": \"<string>\",\n  \"receiverName\": \"<string>\",\n  \"txId\": \"<long>\",\n  \"senderIban\": \"<string>\",\n  \"sepa\": {\n    \"iban\": \"<string>\",\n    \"bankIdentifierCode\": \"<string>\"\n  },\n  \"fasterPayments\": {\n    \"accountNumber\": \"<string>\",\n    \"sortCode\": \"<string>\"\n  },\n  \"accountDescriptor\": {\n    \"accountDescriptor\": \"<string>\"\n  },\n  \"paymentNetwork\": \"<string>\"\n}",
