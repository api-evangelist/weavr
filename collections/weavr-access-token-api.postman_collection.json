{
  "info": {
    "_postman_id": "cad114c1-ea95-49dd-a4bd-9457347a1db2",
    "name": "Weavr Multi Product BackOffice Access Token API",
    "description": "Weavr Multi Back Office API allows you, as an innovator, to perform various back office operations concerning\nidentities and their instruments, without requiring the users to be logged in.\n\nA token is to be obtained through the `access_token` method, and this will allow relevant operations\nto be performed on behalf of this same identity.\n\nContact Support:\n Name: Weavr",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "createdAt": "2026-10-21T19:51:11.000Z",
    "updatedAt": "2026-10-21T19:51:12.000Z",
    "lastUpdatedBy": "35240",
    "uid": "35240-cad114c1-ea95-49dd-a4bd-9457347a1db2"
  },
  "item": [
    {
      "name": "access_token",
      "item": [
        {
          "name": "Acquire a new access token",
          "id": "b6d06d73-4112-4566-b96c-5e73bf459296",
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          },
          "request": {
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "api-key",
                  "type": "string"
                },
                {
                  "key": "value",
                  "value": "{{apiKey}}",
                  "type": "string"
                },
                {
                  "key": "in",
                  "value": "header",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identity\": {\n    \"type\": \"CORPORATE\",\n    \"id\": \"36497\"\n  },\n  \"temp\": {\n    \"type\": \"CORPORATE\",\n    \"id\": \"4229741793\"\n  }\n}",
              "options": {
                "raw": {
                  "headerFamily": "json",
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/access_token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "access_token"
              ]
            },
            "description": "Acquire a `Bearer` token granting you access to securely perform delegated access operations on behalf of the given `identity`.\n\nThe token representing the identity should be included in the `Authorization` header of all requests to endpoints representing Delegated Access operations."
          },
