          "name": "Impersonate login for an identity",
          "request": {
            "name": "Impersonate login for an identity",
            "description": {
              "content": "Get a token representing the given `identity`. This token can then be used to authorise certain secure\noperations on behalf of the identity.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "impersonate_identity_login"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identity\": {\n    \"type\": \"<string>\",\n    \"id\": \"<string>\"\n  },\n  \"temp\": {\n    \"type\": \"<string>\",\n    \"id\": \"<string>\"\n  }\n}",
