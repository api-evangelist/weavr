{
  "opencollection": "1.0.0",
  "info": {
    "name": "Weavr Multi Product BackOffice Access Token Passwords API",
    "version": "v3"
  },
  "items": [
    {
      "info": {
        "name": "Passwords",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create a password",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://sandbox.weavr.io/multi/backoffice/v1/password/:user_id",
            "params": [
              {
                "name": "user_id",
                "value": "",
                "type": "path",
                "description": "The unique identifier for the user."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new password for the user identified by the `user_id` path parameter."
        },
        {
          "info": {
            "name": "Update a password",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://sandbox.weavr.io/multi/backoffice/v1/passwords/update",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update the password for the logged-in user."
        },
        {
          "info": {
            "name": "Validate a password",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://sandbox.weavr.io/multi/backoffice/v1/passwords/validate",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Check that a password adheres to all complexity checks."
        },
        {
          "info": {
            "name": "Initiate lost password process",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://sandbox.weavr.io/multi/backoffice/v1/passwords/lost_password/start",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Initiate the lost password process.\n\nIf the email address provided is associated with an active user, an email will be sent, containing a URL that redirects the user to change their password.\nThe URL contains request parameters for all of the parameters required to change the password for the user via the `/passwords/lost_password/resume` POST endpoint.\n"
        },
        {
          "info": {
            "name": "Resume lost password process",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://sandbox.weavr.io/multi/backoffice/v1/passwords/lost_password/resume",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "This is the second and final step in updating the password of a user who forgot their password.\n"
        }
      ]
    }
  ],
  "bundled": true
}