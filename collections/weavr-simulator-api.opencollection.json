          "info": {
            "name": "Simulate Fund a Payment run",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://sandbox.weavr.io/multi/backoffice/simulate/v1/payment_runs/:payment_run_id/fund_group/:reference",
            "params": [
              {
                "name": "payment_run_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "reference",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Simulate funding a payment run using a linked account.\n\n*This endpoint will only function in Sandbox and should not be used in the Live environment.*\n"
        },
        {
          "info": {
            "name": "Simulate Creating a Linked Account via Open Banking",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://sandbox.weavr.io/multi/backoffice/simulate/v1/linked_accounts",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "The Linked Account Simulator allows you to create a simulated linked account that can be used for funding payment runs.\n\n*This endpoint will only function in Sandbox and should not be used in the Live environment.*\n"
        },
        {
