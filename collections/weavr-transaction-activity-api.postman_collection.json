  },
  "item": [
    {
      "name": "transactions",
      "item": [
        {
          "name": "Get all transaction activity",
          "id": "70f0a1e1-45dc-4ff8-92e0-88f9217f0520",
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          },
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/transactions?offset=<integer>&limit=<integer>&type=sends&type=fees&status=PROCESSING&status=SUBMITTED&direction=CREDIT&creationTimestampFrom=<long>&creationTimestampTo=<long>&lastUpdatedTimestampFrom=<long>&lastUpdatedTimestampTo=<long>&sortOrder=DESC&sortBy=creationTimestamp",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "transactions"
              ],
              "query": [
                {
                  "description": "The offset value for paging, indicating the initial item number to be returned from the data set satisfying the given criteria. Leave out to fetch the first page of results.",
                  "key": "offset",
                  "value": "<integer>"
                },
                {
                  "description": "The limit of the results for paging, starting at the offset. Limit is always capped at 100.",
                  "key": "limit",
                  "value": "<integer>"
                },
                {
                  "description": "Filter by one or more transaction activity types.",
                  "key": "type",
                  "value": "sends"
                },
                {
                  "description": "Filter by one or more transaction activity types.",
                  "key": "type",
                  "value": "fees"
                },
                {
                  "description": "Filter by one or more normalised transaction statuses.",
                  "key": "status",
                  "value": "PROCESSING"
                },
                {
                  "description": "Filter by one or more normalised transaction statuses.",
                  "key": "status",
                  "value": "SUBMITTED"
                },
                {
                  "description": "Filter by transaction direction (CREDIT or DEBIT).",
                  "key": "direction",
                  "value": "CREDIT"
                },
                {
                  "description": "Filter for transactions created after this timestamp. Epoch timestamp using millisecond precision.",
                  "key": "creationTimestampFrom",
                  "value": "<long>"
                },
                {
                  "description": "Filter for transactions created before this timestamp. Epoch timestamp using millisecond precision.",
                  "key": "creationTimestampTo",
                  "value": "<long>"
                },
                {
                  "description": "Filter for transactions last updated after this timestamp. Useful for pulling recently changed transactions. Epoch timestamp using millisecond precision.",
                  "key": "lastUpdatedTimestampFrom",
                  "value": "<long>"
                },
                {
                  "description": "Filter for transactions last updated before this timestamp. Epoch timestamp using millisecond precision.",
                  "key": "lastUpdatedTimestampTo",
                  "value": "<long>"
                },
                {
                  "description": "Sort order for the results:\n  - ASC: Ascending order, oldest first.\n  - DESC: Descending order, most recent first.\n",
                  "key": "sortOrder",
                  "value": "DESC"
                },
                {
                  "description": "The field to sort transaction activity results by. Defaults to `creationTimestamp`.",
                  "key": "sortBy",
                  "value": "creationTimestamp"
                }
              ]
            },
            "description": "Returns all transactional activity across all managed accounts and managed cards.\n\nThis provides a single view of all transfers, sends, wire transfers, card payments, fees, and other\ntransaction types regardless of which wallet they belong to.\n\n`creationTimestamp` is when the transaction was created in its owning service (the same value the\nnested `transaction` object reports), and is the field the creation-window filter applies to.\nTransactions that are committed but not yet executed (e.g. scheduled wire transfers) appear with\nstatus `SUBMITTED`; such transactions never appear on statements until they execute.\n\nA transfer between two of the caller's own instruments (e.g. between a managed account and a\nmanaged card belonging to the same identity) returns **two** entries \u2014 a `DEBIT` on the source\ninstrument and a `CREDIT` on the destination instrument \u2014 which share the same `id` and differ by\n`instrument`. Treat `(id, instrument)` as the key when reconciling, and note that such a transfer\ncontributes 2 to the `count`. The per-instrument activity endpoints\n(`/managed_accounts/{id}/transactions`, `/managed_cards/{id}/transactions`) are scoped to one\ninstrument and so still show the single relevant side."
          },
