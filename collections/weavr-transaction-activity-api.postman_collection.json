{
  "item": [
    {
      "id": "d40ca33a-4daa-41db-9f89-32f6173c8d71",
      "name": "Transaction Activity",
      "description": {
        "content": "Retrieve the consolidated transaction activity across instruments.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "e276fd6d-922c-4de4-8b07-c9aae9848833",
          "name": "Get all transaction activity",
          "request": {
            "name": "Get all transaction activity",
            "description": {
              "content": "Returns all transactional activity across all managed accounts and managed cards.\n\nThis provides a single view of all transfers, sends, wire transfers, card payments, fees, and other\ntransaction types regardless of which wallet they belong to.\n\n`creationTimestamp` is when the transaction was created in its owning service (the same value the\nnested `transaction` object reports), and is the field the creation-window filter applies to.\nTransactions that are committed but not yet executed (e.g. scheduled wire transfers) appear with\nstatus `SUBMITTED`; such transactions never appear on statements until they execute.\n\nA transfer between two of the caller's own instruments (e.g. between a managed account and a\nmanaged card belonging to the same identity) returns **two** entries — a `DEBIT` on the source\ninstrument and a `CREDIT` on the destination instrument — which share the same `id` and differ by\n`instrument`. Treat `(id, instrument)` as the key when reconciling, and note that such a transfer\ncontributes 2 to the `count`. The per-instrument activity endpoints\n(`/managed_accounts/{id}/transactions`, `/managed_cards/{id}/transactions`) are scoped to one\ninstrument and so still show the single relevant side.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "transactions"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "offset",
                  "value": "<integer>",
                  "description": "The offset value for paging, indicating the initial item number to be returned from the data set satisfying the given criteria. Leave out to fetch the first page of results."
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "<integer>",
                  "description": "The limit of the results for paging, starting at the offset. Limit is always capped at 100."
                },
                {
                  "disabled": false,
                  "key": "type",
                  "value": "<string>",
                  "description": "Filter by one or more transaction activity types."
                },
                {
                  "disabled": false,
                  "key": "type",
                  "value": "<string>",
                  "description": "Filter by one or more transaction activity types."
                },
                {
                  "disabled": false,
                  "key": "status",
                  "value": "<string>",
                  "description": "Filter by one or more normalised transaction statuses."
                },
                {
                  "disabled": false,
                  "key": "status",
                  "value": "<string>",
                  "description": "Filter by one or more normalised transaction statuses."
                },
                {
                  "disabled": false,
                  "key": "direction",
                  "value": "<string>",
                  "description": "Filter by transaction direction (CREDIT or DEBIT)."
                },
                {
                  "disabled": false,
                  "key": "creationTimestampFrom",
                  "value": "<long>",
                  "description": "Filter for transactions created after this timestamp. Epoch timestamp using millisecond precision."
                },
                {
                  "disabled": false,
                  "key": "creationTimestampTo",
                  "value": "<long>",
                  "description": "Filter for transactions created before this timestamp. Epoch timestamp using millisecond precision."
                },
                {
                  "disabled": false,
                  "key": "lastUpdatedTimestampFrom",
                  "value": "<long>",
                  "description": "Filter for transactions last updated after this timestamp. Useful for pulling recently changed transactions. Epoch timestamp using millisecond precision."
                },
                {
                  "disabled": false,
                  "key": "lastUpdatedTimestampTo",
                  "value": "<long>",
                  "description": "Filter for transactions last updated before this timestamp. Epoch timestamp using millisecond precision."
                },
                {
                  "disabled": false,
                  "key": "sortOrder",
                  "value": "<string>",
                  "description": "Sort order for the results:\n  - ASC: Ascending order, oldest first.\n  - DESC: Descending order, most recent first.\n"
                },
                {
                  "disabled": false,
                  "key": "sortBy",
                  "value": "<string>",
                  "description": "The field to sort transaction activity results by. Defaults to `creationTimestamp`."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            }
          },
